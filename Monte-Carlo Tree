import random


class Node:
    def __init__(self, value=None):
        self.value = value
        self.children = []
        self.visits = 0
        self.wins = 0


def simulate(node):
    """
    Random simulation from current node.
    """
    current = node

    while current.children:
        current = random.choice(current.children)

    return current.value


def mcts(root, iterations):

    for _ in range(iterations):

        # Selection
        current = root

        while current.children:
            current = random.choice(current.children)

        # Simulation
        result = current.value

        # Backpropagation
        current.visits += 1
        current.wins += result

    best_child = max(
        root.children,
        key=lambda child: child.value
    )

    return best_child.value


